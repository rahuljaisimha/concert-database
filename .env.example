# Copy to .env and fill in. Never commit .env.
CONCERTDB_PATH=data/ledger.sqlite

# https://www.setlist.fm/settings/api — use a key separate from MusicSceneMap's.
SETLISTFM_API_KEY=

# Cloudflare R2 backups: a PRIVATE bucket and an API token with Object Read &
# Write on that bucket only. R2_ACCOUNT_ID is in the R2 dashboard sidebar.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=concert-database
# Optional: override the User-Agent sent to Pollstar.
POLLSTAR_USER_AGENT=
# Optional: Pollstar pacing (seconds between requests, default 1) and daily cap
# (default 20000) for the separate `concertdb pollstar` process.
POLLSTAR_INTERVAL=
POLLSTAR_DAILY_LIMIT=
