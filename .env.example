# Copy to .env and fill in. Never commit .env.
CONCERTDB_PATH=data/ledger.sqlite

# https://www.setlist.fm/settings/api — use a key separate from MusicSceneMap's.
SETLISTFM_API_KEY=

# https://aistudio.google.com/apikey — for `concertdb gemini` (free tier is enough).
GEMINI_API_KEY=
# Web search for `concertdb gemini`, tried in SEARCH_ORDER (default contextdev,searxng),
# then Firecrawl: context.dev (https://www.context.dev, 2 credits a search with
# highlights), a local SearXNG (free; `deploy/searxng.sh install`, deploy/run-gemini.sh
# starts it), Firecrawl (https://www.firecrawl.dev/app/api-keys, 1,000 free credits a month).
CONTEXT_DEV_API_KEY=
SEARXNG_URL=http://127.0.0.1:8888
FIRECRAWL_API_KEY=
SEARCH_ORDER=
# Optional: cap on Firecrawl credits per calendar month (default: none; a run
# spends what's left until Firecrawl says the credits are gone; a search costs 2).
FIRECRAWL_MONTHLY_CREDITS=
# Optional: pin a model (default: gemini-3.5-flash-lite).
GEMINI_MODEL=
# Optional: only ask about shows with at most this many acts listed (default 1,
# i.e. skip any show that already has two or more acts).
GEMINI_MAX_ACTS=

# Cloudflare R2 backups: a PRIVATE bucket and an API token with Object Read &
# Write on that bucket only. R2_ACCOUNT_ID is in the R2 dashboard sidebar.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=concert-database
# Optional: override the User-Agent sent to Pollstar.
POLLSTAR_USER_AGENT=
# Optional: Pollstar pacing (seconds between requests to start at and never go
# below, default 6; it slows down by itself after pushback) and daily cap
# (default 20000) for the separate `concertdb pollstar` process.
POLLSTAR_INTERVAL=
POLLSTAR_DAILY_LIMIT=
# Optional: days of raw response archive kept on this machine (default 30, 0 = all).
CONCERTDB_RAW_KEEP_DAYS=
