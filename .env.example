# Copy to .env and fill in. Never commit .env.
CONCERTDB_PATH=data/ledger.sqlite

# https://www.setlist.fm/settings/api — use a key separate from MusicSceneMap's.
SETLISTFM_API_KEY=

# Cloudflare R2 backups (bucket e.g. concert-database-backup, an API token
# with Object Read & Write on that bucket only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: override the User-Agent sent to Pollstar.
POLLSTAR_USER_AGENT=
